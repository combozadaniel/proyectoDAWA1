# Copiar a .env (o .env.development / .env.test / .env.production) y completar.
# NUNCA subir los archivos .env reales al repositorio.

NODE_ENV=development
PORT=4000

# Cadena de conexión PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/servigest
# Poner true si el proveedor exige SSL (Neon, Render, etc.)
DATABASE_SSL=false

# Secreto para firmar JWT (mínimo 32 caracteres en producción)
JWT_SECRET=cambie-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# Orígenes permitidos por CORS (separados por coma)
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

UPLOAD_DIR=uploads
BCRYPT_ROUNDS=10
