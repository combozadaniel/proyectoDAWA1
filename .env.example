# Variables para docker compose. Copiar a .env y cambiar los valores. NUNCA subir .env al repositorio.
POSTGRES_USER=servigest
POSTGRES_PASSWORD=cambie-esta-clave
# Mínimo 32 caracteres. Generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=reemplace-por-un-secreto-aleatorio-de-al-menos-32-caracteres
JWT_EXPIRES_IN=8h
# URL pública con la que se accede al sistema (para CORS y enlaces de restablecimiento)
PUBLIC_URL=http://localhost:8080
HTTP_PORT=8080
# true = carga datos de demostración la primera vez (usuarios @servigest.ec, clave Servigest2026)
SEED_DEMO=true
